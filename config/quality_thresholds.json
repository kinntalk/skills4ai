{
  "min_success_rate": 70.0,
  "min_overall_score": 70.0,
  "max_keyword_overlaps": 10,
  "max_consistency_issues": 5,
  "warning_success_rate": 85.0,
  "warning_overall_score": 85.0,
  "alert_levels": {
    "critical": {
      "description": "Critical quality issues that require immediate attention",
      "conditions": {
        "overall_score_below": 70,
        "success_rate_below": 70,
        "consistency_issues_above": 10,
        "keyword_overlaps_above": 20
      },
      "actions": [
        "block_merge",
        "send_immediate_notification",
        "create_issue"
      ]
    },
    "error": {
      "description": "Error level quality issues that should be fixed before merge",
      "conditions": {
        "overall_score_below": 80,
        "success_rate_below": 80,
        "consistency_issues_above": 5,
        "keyword_overlaps_above": 10
      },
      "actions": [
        "warn_before_merge",
        "send_notification",
        "add_pr_comment"
      ]
    },
    "warning": {
      "description": "Warning level issues that should be addressed soon",
      "conditions": {
        "overall_score_below": 90,
        "success_rate_below": 90,
        "consistency_issues_above": 2,
        "keyword_overlaps_above": 5
      },
      "actions": [
        "log_warning",
        "add_pr_comment"
      ]
    }
  },
  "notification_methods": {
    "console": {
      "enabled": true,
      "description": "Output alerts to console"
    },
    "file": {
      "enabled": true,
      "description": "Save alerts to JSON file in reports directory",
      "format": "json"
    },
    "email": {
      "enabled": false,
      "description": "Send alerts via email",
      "recipients": [],
      "subject_prefix": "[Quality Alert]"
    },
    "webhook": {
      "enabled": false,
      "description": "Send alerts to webhook endpoint",
      "url": "",
      "headers": {}
    },
    "slack": {
      "enabled": false,
      "description": "Send alerts to Slack channel",
      "webhook_url": "",
      "channel": "#quality-alerts"
    }
  },
  "threshold_categories": {
    "quality_score": {
      "critical": 70,
      "error": 80,
      "warning": 90,
      "description": "Overall quality score from quality_check.py"
    },
    "success_rate": {
      "critical": 70,
      "error": 80,
      "warning": 90,
      "description": "Success rate from usage_tracker.py"
    },
    "consistency_issues": {
      "critical": 10,
      "error": 5,
      "warning": 2,
      "description": "Number of consistency issues found"
    },
    "keyword_overlaps": {
      "critical": 20,
      "error": 10,
      "warning": 5,
      "description": "Number of keyword overlaps detected"
    },
    "invocation_frequency": {
      "critical": 0,
      "error": 0,
      "warning": 5,
      "description": "Minimum invocations per week for active skills"
    },
    "execution_time": {
      "critical": 30,
      "error": 20,
      "warning": 10,
      "description": "Maximum average execution time in seconds"
    }
  },
  "scheduled_checks": {
    "weekly": {
      "enabled": true,
      "day_of_week": "monday",
      "time": "09:00",
      "timezone": "UTC",
      "checks": [
        "consistency",
        "keywords",
        "usage"
      ]
    },
    "monthly": {
      "enabled": true,
      "day_of_month": 1,
      "time": "09:00",
      "timezone": "UTC",
      "checks": [
        "consistency",
        "keywords",
        "usage",
        "trends"
      ]
    }
  },
  "report_settings": {
    "save_reports": true,
    "report_retention_days": 90,
    "report_formats": [
      "json",
      "txt"
    ],
    "include_recommendations": true,
    "include_statistics": true,
    "include_history": true
  },
  "auto_fix": {
    "enabled": false,
    "description": "Automatically fix certain issues",
    "fix_missing_skills": false,
    "fix_missing_skill_md": false,
    "fix_path_errors": false
  }
}
