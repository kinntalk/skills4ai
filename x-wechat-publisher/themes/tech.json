{
  "body": {
    "font-family": "'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "font-size": "16px",
    "line-height": "1.75",
    "color": "#24292e",
    "padding": "20px",
    "background": "#ffffff"
  },
  "h1": {
    "font-size": "28px",
    "font-weight": "600",
    "margin": "24px 0 16px 0",
    "color": "#1a1a1a",
    "border-bottom": "1px solid #e1e4e8",
    "padding-bottom": "10px"
  },
  "h2": {
    "font-size": "22px",
    "font-weight": "600",
    "margin": "20px 0 12px 0",
    "color": "#24292e",
    "border-left": "4px solid #0366d6",
    "padding-left": "12px"
  },
  "h3": {
    "font-size": "18px",
    "font-weight": "600",
    "margin": "16px 0 8px 0",
    "color": "#444d56"
  },
  "p": {
    "margin": "12px 0",
    "text-align": "justify"
  },
  "blockquote": {
    "border-left": "4px solid #0366d6",
    "padding": "12px 16px",
    "margin": "16px 0",
    "background": "#f6f8fa",
    "color": "#586069"
  },
  "code": {
    "font-family": "'Fira Code', 'SF Mono', Consolas, monospace",
    "background": "#f6f8fa",
    "padding": "2px 6px",
    "border-radius": "4px",
    "font-size": "14px",
    "color": "#d73a49"
  },
  "pre": {
    "background": "#24292e",
    "padding": "16px",
    "border-radius": "6px",
    "overflow-x": "auto",
    "margin": "16px 0",
    "color": "#f6f8fa"
  },
  "img": {
    "max-width": "100%",
    "height": "auto",
    "display": "block",
    "margin": "16px auto",
    "border-radius": "6px",
    "border": "1px solid #e1e4e8"
  },
  "ul": {
    "padding-left": "24px",
    "margin": "12px 0"
  },
  "ol": {
    "padding-left": "24px",
    "margin": "12px 0"
  },
  "li": {
    "margin": "6px 0"
  },
  "a": {
    "color": "#0366d6",
    "text-decoration": "none"
  },
  "table": {
    "width": "100%",
    "border-collapse": "collapse",
    "margin": "16px 0"
  },
  "th": {
    "background": "#f6f8fa",
    "padding": "12px",
    "border": "1px solid #e1e4e8",
    "font-weight": "600",
    "text-align": "left"
  },
  "td": {
    "padding": "12px",
    "border": "1px solid #e1e4e8"
  }
}
